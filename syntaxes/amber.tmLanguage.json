{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Amber Snapshot",
  "patterns": [
    {
      "include": "#serializer-version"
    },
    {
      "include": "#snapshot"
    }
  ],
  "repository": {
    "serializer-version": {
      "name": "keyword.serializer-version.amber",
      "match": "#\\sserializer\\sversion:\\s\\d"
    },
    "snapshot": {
      "name": "snapshot.embedded.python",
      "begin": "^# name: .*?$",
      "end": "^# ---$",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.amber.snapshot.open"
        }
      },
      "endCaptures": {
        "0": {
          "name": "keyword.control.amber.snapshot.close"
        }
      },
      "contentName": "meta.embedded.python",
      "patterns": [
        {
          "include": "source.python"
        }
      ]
    }
  },
  "scopeName": "source.amber"
}
